# Copy to .env.local for local development. Never commit real values.

# PostgreSQL connection string. For Supabase use the "Transaction pooler" URI (port 6543) from
# Project Settings → Database → Connection string, with your database password filled in.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres"

# Optional: PEM of the Supabase root CA (Project Settings → Database → SSL configuration) to verify TLS.
# Without it the connection is still encrypted but the server certificate is not verified.
DATABASE_CA_CERT=""

# Password you will type to sign in to the site (required in production).
APP_PASSWORD="choose-a-long-passphrase"

# Random secret used to sign the login cookie, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-64-random-hex-characters"
